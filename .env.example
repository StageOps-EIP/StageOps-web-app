# Copier ce fichier en .env puis remplacer les valeurs.
# Le fichier .env ne doit jamais être commité.

COUCHDB_USER=stageops
COUCHDB_PASSWORD=change-me
COUCHDB_DB=stageops

# Secret de signature JWT : chaîne longue et aléatoire.
JWT_SECRET=replace-with-a-long-random-secret

# Facultatif : proxy HTTP utilisé uniquement pendant la construction des images.
STAGEOPS_NET_BRIDGE=
