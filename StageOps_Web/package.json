{
  "name": "stageops-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "benchmark:collect": "node scripts/benchmark-collect.mjs",
    "benchmark:scenarios": "node scripts/benchmark-scenarios.mjs",
    "benchmark:roadmap": "node scripts/benchmark-roadmap.mjs",
    "benchmark:all": "npm run benchmark:collect && npm run benchmark:scenarios && npm run benchmark:roadmap",
    "rncp:c3": "node scripts/rncp-c3-generate.mjs",
    "preview": "vite preview",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/postprocessing": "2.19.1",
    "lucide-react": "0.487.0",
    "postprocessing": "6.38.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.1",
    "sonner": "2.0.7",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.11.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "^29.0.0",
    "postcss": "8.5.8",
    "prettier": "3.8.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "7.3.1",
    "vitest": "^4.1.0"
  }
